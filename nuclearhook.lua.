-- INSTANT HIT: common remote names across many games local InstantHitRemotes = { "RemoteEvent", "HitEvent", "DamageEvent", "BulletHit", "ProjectileHit", "WeaponHit", "MeleeHit", "RemoteFunction", "HitRemote", "FireEvent" }

local function FireInstantHit(target) if not target or not target.Character then return end -- Try through the tool/weapon local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool") if tool then for _, name in ipairs(InstantHitRemotes) do local ev = tool:FindFirstChild(name, true) if ev and (ev:IsA("RemoteEvent") or ev:IsA("RemoteFunction")) then pcall(function() if ev:IsA("RemoteEvent") then ev:FireServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart")) else ev:InvokeServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart")) end end) end end end -- Try generic workspace remotes for _, name in ipairs(InstantHitRemotes) do for _, obj in ipairs(workspace:GetDescendants()) do if obj.Name == name and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then pcall(function() if obj:IsA("RemoteEvent") then obj:FireServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart")) else obj:InvokeServer(target.Character, target.Character:FindFirstChild("HumanoidRootPart")) end end) end end end end

-- RAGE BOT fire loop local lastRageFire = 0

RunService:BindToRenderStep("NuclearHookAim", Enum.RenderPriority.Camera.Value + 5, function() local center = ScreenCenter()

local wantAntiDrop  = _G.AntiDropOff  or IsBindDown(Binds.AntiDrop)
local wantInstant   = _G.InstantHit   or IsBindDown(Binds.InstantHit)
local wantRage      = _G.RageBot      or IsBindDown(Binds.RageBot)
local wantSilent    = _G.SilentAim    or IsBindDown(Binds.Silent)
local wantLock      = _G.LockAim      or IsBindDown(Binds.Lock)
local wantSmooth    = _G.SmoothAim    or IsBindDown(Binds.Smooth)
local wantSpin      = _G.Spinbot      or IsBindDown(Binds.Spin)
local wantPred      = _G.Prediction   or IsBindDown(Binds.Pred)

-- Override anti-drop if rage is active
if wantRage then
	_G.AntiDropOff = true -- force anti-drop during rage
end

local target = GetClosest(center)

-- For rage bot, always override with the closest target
if wantRage and not target then
	-- Find ANY target, ignoring FOV
	target = GetClosest(center)
	-- If still nothing, widen search
	if not target then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr == LocalPlayer then continue end
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				if _G.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team then continue end
				target = plr
				break
			end
		end
	end
end

local aimPos = nil
if target and target.Character then
	local aimPart = GetAimPart(target.Character)
	if aimPart then
		aimPos = aimPart.Position
		if wantPred then
			aimPos = aimPos + (aimPart.AssemblyLinearVelocity * 0.14)
		end
	end
end

if aimPos then
	if wantSilent then
		SilentTarget = target
		SilentAimPos = aimPos
		if not canHook then
			Camera.CameraType = Enum.CameraType.Scriptable
			Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPos)
		end
	else
		SilentTarget, SilentAimPos = nil, nil

		if wantLock then
			if Camera.CameraType ~= Enum.CameraType.Scriptable then
				originalCameraType = Camera.CameraType
				Camera.CameraType = Enum.CameraType.Scriptable
			end
			Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimPos)
		elseif wantSmooth then
			if Camera.CameraType == Enum.CameraType.Scriptable then
				Camera.CameraType = originalCameraType
			end
			local goal = CFrame.lookAt(Camera.CFrame.Position, aimPos)
			Camera.CFrame = Camera.CFrame:Lerp(goal, 0.18)
		else
			if Camera.CameraType == Enum.CameraType.Scriptable then
				Camera.CameraType = originalCameraType
			end
		end
	end

	-- RAGE BOT auto-fire
	if wantRage and aimPos and target then
		local now = os.clock()
		if now - lastRageFire >= _G.RageFireRate then
			-- Check hit chance
			if math.random(1, 100) <= _G.HitChance then
				pcall(function() mouse1click() end)
				-- Also try instant hit if enabled
				if wantInstant then
					FireInstantHit(target)
				end
			end
			lastRageFire = now
		end
	end
else
	SilentTarget, SilentAimPos = nil, nil
	if Camera.CameraType == Enum.CameraType.Scriptable then
		Camera.CameraType = originalCameraType
	end
end

if wantSpin and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
	LocalPlayer.Character.HumanoidRootPart.CFrame *= CFrame.Angles(0, math.rad(16), 0)
end
end)

-- Triggerbot (works as toggle OR while holding its bind) local lastClick = 0 RunService.Heartbeat:Connect(function() local wantTrigger = _G.Triggerbot or IsBindDown(Binds.Trigger) local wantInstant = _G.InstantHit or IsBindDown(Binds.InstantHit) if not wantTrigger then return end

-- If rage bot is active, let it handle shooting instead
local wantRage = _G.RageBot or IsBindDown(Binds.RageBot)
if wantRage then return end

local now = os.clock()
if now - lastClick < 0.06 then return end
local center = ScreenCenter()
local t = GetClosest(center)
if t and t.Character then
	local aimPart = GetAimPart(t.Character)
	local pos, on = nil, false
	if aimPart then
		pos, on = Camera:WorldToViewportPoint(aimPart.Position)
	end
	if on and (Vector2.new(pos.X, pos.Y) - center).Magnitude < 24 then
		-- Check hit chance before firing
		if math.random(1, 100) <= _G.HitChance then
			pcall(function() mouse1click() end)
			-- Also fire instant hit remotes
			if wantInstant then
				FireInstantHit(t)
			end
		end
		lastClick = now
	end
end
end)

-- FLY local flyBV, flyBG, flyChar = nil, nil, nil

local function StopFly() if flyBV then pcall(function() flyBV:Destroy() end) end if flyBG then pcall(function() flyBG:Destroy() end) end if flyChar then local hum = flyChar:FindFirstChildOfClass("Humanoid") if hum then pcall(function() hum.PlatformStand = false end) end end flyBV, flyBG, flyChar = nil, nil, nil end

local function StartFly(char) StopFly() if not char then return end local root = char:WaitForChild("HumanoidRootPart", 5) local hum = char:WaitForChild("Humanoid", 5) if not root or not hum then return end flyBV = Instance.new("BodyVelocity") flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9) flyBV.Parent = root flyBG = Instance.new("BodyGyro") flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9) flyBG.P = 9e4 flyBG.D = 800 flyBG.Parent = root hum.PlatformStand = true flyChar = char end

LocalPlayer.CharacterAdded:Connect(function(char) StopFly() if _G.Fly then task.delay(0.3, function() if _G.Fly and char == LocalPlayer.Character then StartFly(char) end end) end end)

LocalPlayer.CharacterRemoving:Connect(StopFly)

RunService.RenderStepped:Connect(function() local char = LocalPlayer.Character if _G.Fly then if (not flyBV or not flyBV.Parent) and char then StartFly(char) end if flyBV and flyBG and char then local root = char:FindFirstChild("HumanoidRootPart") if root then local dir = Vector3.zero if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end local speed = _G.FlySpeed if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 2 end flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * speed or Vector3.zero flyBG.CFrame = Camera.CFrame end end else StopFly() end end)


	if menuOpen then
		CloseMenu()
	else
		if not KeyGui or not KeyGui.Parent then
			OpenMenu()
		end
	end
end

if inp.KeyCode == Enum.KeyCode.RightAlt then
	if menuOpen then
		CloseMenu()
	else
		if not KeyGui or not KeyGui.Parent then
			OpenMenu()
		end
	end
end
